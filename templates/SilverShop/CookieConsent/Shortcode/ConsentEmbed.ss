<div class="consent-embed consent-embed--$Ratio" data-consent-embed data-consent-category="$Category.ATT" data-embed-src="$EmbedSrc.ATT" data-embed-title="$EmbedTitle.ATT">
    <div class="consent-embed__placeholder">
        <p class="consent-embed__text"><%t SilverShop\CookieConsent\Shortcode\ConsentEmbed.Blocked 'This content is blocked until you accept {category} cookies.' category=$Category %></p>
        <button type="button" class="consent__btn consent__btn--primary" data-consent-embed-load><%t SilverShop\CookieConsent\Shortcode\ConsentEmbed.Load 'Load content' %></button>
        <button type="button" class="consent__btn consent__btn--link" data-consent-embed-always><%t SilverShop\CookieConsent\Shortcode\ConsentEmbed.Always 'Always allow' %></button>
    </div>
</div>
